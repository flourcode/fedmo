{
  "_meta": {
    "version": "2.0",
    "last_updated": "2026-04-21",
    "description": "Vendor → category map. Categories own keyword lists (one source of truth per category). Vendors reference categories by key and carry their own competitor list. Used by stream-client.js for two things: (1) category-aware fallback when a vendor+agency pull returns empty (Turn E), and (2) post-filtering competitor-mode rows to require at least one category keyword in the description/recipient/title (Turn F — prevents ambiguous product names like 'Falcon' matching unrelated contracts like Bahrain F-16 production). Schema intentionally minimal — we add fields when features consume them, not preemptively.",
    "schema": {
      "categories[key].keywords": "array of uppercase strings — what USASpending descriptions actually say for this category. Not marketing terms. Used both as fallback keyword set AND as post-filter whitelist for competitor cuts.",
      "vendors[key].canonical": "display name for the vendor. Used in UI labels and prose framing.",
      "vendors[key].category": "key into the categories map. Must match a category key exactly.",
      "vendors[key].competitors": "array of display names for head-to-head competitors. Used to build the competitor-mode vendor list."
    }
  },

